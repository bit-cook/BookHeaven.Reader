@attribute [Route(Urls.Apps)]
@using BookHeaven.Reader.Components.Shared.ContextMenu
@using AppInfo = BookHeaven.Reader.Entities.AppInfo
@implements IDisposable

<SectionContent SectionName="Header">
    <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold mx-4 my-3">@Translations.APPS</h1>
        <Button Class="h-full" OnClick="RefreshAppsAsync">
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-reload"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747" /><path d="M20 4v5h-5" /></svg>
        </Button>
    </div>
    <hr/>
</SectionContent>

@if (AppsService.Apps.Count > 0)
{
    <div class="grid grid-cols-6 auto-rows-fr gap-x-4 gap-y-6 p-4 justify-center">
        @foreach (var app in FilteredApps)
        {
            <div 
	            class="grid gap-0.5 w-full overflow-hidden rounded active:bg-neutral-200 active:outline-4 active:outline-neutral-200" 
	            @onclick="@(() => AppsService.OpenApp(app.PackageName!))"
	            @oncontextmenu="@(e => ShowContextMenu(e, app))"
	            @oncontextmenu:preventDefault="true">
                <img src="data:image/png;base64,@app.IconBase64" class="mx-auto w-16 px-2" alt="App icon" draggable="false"/>
                <label class="text-xs text-nowrap select-none overflow-hidden text-ellipsis text-center mt-2">@app.Name</label>
            </div>
        }
    </div>
}

@code {
	[Inject] private IContextMenuService ContextMenuService { get; set; } = null!;
    [Inject] private IAppsService AppsService { get; set; } = null!;
    [Inject] private LifeCycleService LifeCycleService { get; set; } = null!;
    
    private List<AppInfo> FilteredApps =>
        _sortBy switch
        {
            SortBy.Added => AppsService.Apps.OrderBy(x => x.Date).ToList(),
            SortBy.Name => AppsService.Apps.OrderBy(x => x.Name).ToList(),
            _ => AppsService.Apps
        };
    
    private enum SortBy
    {
        Added,
        Name
    }

    private SortBy _sortBy = SortBy.Name;

    protected override void OnInitialized()
    {
        AppsService.OnAppsChanged += RefreshUiAsync;
        LifeCycleService.Resumed += RefreshAppsAsync;
    }
    
    private void ShowContextMenu(MouseEventArgs e, AppInfo app)
	{
		List<ContextMenuItemModel> menuItems = [
			new()
			{
				Text = app.Name,
				IsDisabled = true
			}
		];

        if (app.Shortcuts.Count > 0)
        {
            foreach(var shortcut in app.Shortcuts)
            {
                menuItems.Add(new ContextMenuItemModel
                {
                    Text = shortcut.ShortLabel,
                    Icon = shortcut.IconBase64 is not null ? $"<img src=\"data:image/png;base64,{shortcut.IconBase64}\" draggable=\"false\"/>" : null,
                    OnClick = () =>
                    {
                        AppsService.OpenAppShortcut(app.PackageName!, shortcut.Id!);
                        return Task.CompletedTask;
                    }
                });
            }
        }
        
        menuItems.Add(new ContextMenuItemModel
        {
            Text = Translations.OPEN,
            Icon = "<svg  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"1\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\"  class=\"me-5 icon icon-tabler icons-tabler-outline icon-tabler-external-link\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6\" /><path d=\"M11 13l9 -9\" /><path d=\"M15 4h5v5\" /></svg>",
            OnClick = () =>
            {
                AppsService.OpenApp(app.PackageName!);
                return Task.CompletedTask;
            }
        });
        
        menuItems.Add(new ContextMenuItemModel
        {
            Text = Translations.INFO,
            Icon = "<svg  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"1\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\"  class=\"me-5 icon icon-tabler icons-tabler-outline icon-tabler-info-circle\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\" /><path d=\"M12 9h.01\" /><path d=\"M11 12h1v4h1\" /></svg>",
            OnClick = () =>
            {
                AppsService.OpenInfo(app.PackageName!);
                return Task.CompletedTask;
            }
        });
        
        if(AppsService.CanBeUninstalled(app.PackageName!))
        {
            menuItems.Add(new ContextMenuItemModel
            {
                Text = Translations.UNINSTALL,
                Icon = "<svg  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"1\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\"  class=\"me-5 icon icon-tabler icons-tabler-outline icon-tabler-trash\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M4 7h16\" /><path d=\"M10 11v6\" /><path d=\"M14 11v6\" /><path d=\"M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12\" /><path d=\"M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3\" /></svg>",
                OnClick = () =>
                {
                    AppsService.UninstallApp(app.PackageName!);
                    return Task.CompletedTask;
                }
            });
        }

		ContextMenuService.OpenMenu((int)e.ClientX, (int)e.ClientY, menuItems);
	}
    
    private void RefreshUiAsync()
    {
        InvokeAsync(StateHasChanged);
    }
    
    private async void RefreshAppsAsync()
    {
        await AppsService.RefreshInstalledAppsAsync();
        await InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        AppsService.OnAppsChanged -= RefreshUiAsync;
        LifeCycleService.Resumed -= RefreshAppsAsync;
        GC.SuppressFinalize(this);
    }

    
}