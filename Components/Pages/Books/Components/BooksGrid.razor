@if (!Books.Any())
{
	<div class="h-full relative">
		<Message Content="@Translations.BOOKS_NO_FILTER_MATCH"/>
	</div>
	return;
}

<div class="h-full py-2">
	<div class="h-full overflow-y-auto snap-y grid grid-cols-[repeat(auto-fill,120px)] items-center justify-evenly gap-2 px-3">
		@foreach (var book in Books) {
			<BookCard Book="book" Class="snap-start" />
		}
	</div>
</div>

@code {
	[Parameter] public IEnumerable<Book> Books { get; set; } = [];
}