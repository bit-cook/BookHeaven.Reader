@using BookHeaven.Core.Abstractions
@using BookHeaven.Core.Enums
@using BookHeaven.Core.Features.Books
@using BookHeaven.Core.Services
@using BookHeaven.Reader.Components.Dialogs.Books
@using BookHeaven.Reader.Components.Shared.ContextMenu
@using BookHeaven.Reader.Extensions
<div class="relative">
	<a 
		data-book-card 
		class="flex h-full flex-col overflow-hidden rounded active:bg-black active:outline-4 active:outline-black" 
		href="@Urls.GetReaderUrl(Book.BookId)" 
		draggable="false"
		@oncontextmenu="ShowContextMenu"
		@oncontextmenu:preventDefault="true">
		<div class="h-[190px] w-full overflow-hidden rounded">
			<img class="h-full w-full" src="@Book.CoverUrlWithCustomScheme" draggable="false" alt=""/>
			<span class="absolute -top-[1px] right-[2px] w-[40%] font-bold">
				<img src="/progress-badge.svg" class="w-full align-top" alt=""/>
				<span class="absolute inset-0 text-center text-[.6rem]">
					@if (Book.ReadingStatus() != BookStatus.New)
					{
						@Book.Progress().Progress.ToString("0.##") @:%
					}
					else
					{
						@Translations.NEW
					}
				</span>
			</span>
		</div>
		@* <div class="p-1 text-xs">@Book.Title</div> *@
	</a>
</div>

@code{
	[Inject] private IAlertService AlertService { get; set; } = null!;
	[Inject] private ISender Sender { get; set; } = null!;
	[Inject] private BookManager BookManager { get; set; } = null!;
	[Inject] private IContextMenuService ContextMenuService { get; set; } = null!;
	[Inject] private BookInfoDialogService BookInfoDialogService { get; set; } = null!;
	
	[Parameter] public required Book Book { get; set; }

	private void ShowContextMenu(MouseEventArgs e)
	{
		List<ContextMenuItemModel> menuItems = [
			new()
			{
				Text = Book.Title,
				IsDisabled = true
			},
			new()
			{
				Icon = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"icon icon-tabler icons-tabler-outline icon-tabler-info-circle\">\n\t<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n\t<path d=\"M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0\" />\n\t<path d=\"M12 9h.01\" />\n\t<path d=\"M11 12h1v4h1\" />\n</svg>",
				Text = Translations.INFO,
				OnClick = () =>
				{
					BookInfoDialogService.Show(Book);
					return Task.CompletedTask;
				}
			}
		];
		
		if(Book.ReadingStatus() != BookStatus.Finished)
		{
			menuItems.Add(new()
			{
				Icon = "<svg  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"1\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\"  class=\"icon icon-tabler icons-tabler-outline icon-tabler-check\"><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"/><path d=\"M5 12l5 5l10 -10\" /></svg>",
				Text = Translations.MARK_AS_FINISHED,
				OnClick = () => BookManager.MarkAsFinishedAsync(Book.BookId)
			});
		}
		
		if(Book.ReadingStatus() != BookStatus.New)
		{
			menuItems.Add(new()
			{
				Icon = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"icon icon-tabler icons-tabler-outline icon-tabler-restore\">\n\t<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n\t<path d=\"M3.06 13a9 9 0 1 0 .49 -4.087\" />\n\t<path d=\"M3 4.001v5h5\" />\n\t<path d=\"M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0\" />\n</svg>",
				Text = Translations.MARK_AS_NEW,
				OnClick = () => BookManager.MarkAsNewAsync(Book.BookId)
			});
		}
		
		menuItems.Add(new()
		{
			Icon = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"icon icon-tabler icons-tabler-outline icon-tabler-trash\">\n\t<path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\" />\n\t<path d=\"M4 7l16 0\" />\n\t<path d=\"M10 11l0 6\" />\n\t<path d=\"M14 11l0 6\" />\n\t<path d=\"M5 7l1 -4h12l1 4\" />\n\t<path d=\"M6 7l0 14a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l0 -14\" />\n</svg>",
			Text = Translations.DELETE,
			OnClick = () => DeleteBook(Book.BookId)
		});
		
		ContextMenuService.OpenMenu((int)e.ClientX, (int)e.ClientY, menuItems);
	}
	
	private async Task DeleteBook(Guid bookId)
	{
		var result = await AlertService.ShowConfirmationAsync("Delete book", $"Are you sure you want to delete this book?{Environment.NewLine}{Environment.NewLine}This will remove the book from your device along with any progress you have.{Environment.NewLine}It will not be removed from your server.");
		if (!result) return;
		try
		{
			await Sender.Send(new DeleteBook.Command(bookId));
		}
		catch (Exception ex)
		{
			await AlertService.ShowAlertAsync("Error deleting book", ex.Message);
			return;
		}

		await AlertService.ShowToastAsync(Core.Localization.Translations.BOOK_DELETED);
		BookManager.RemoveBook(bookId);
	}
}