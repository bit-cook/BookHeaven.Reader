<div 
	class="ctx-item relative flex items-center gap-5 ps-2 pe-3.5 py-3 text-nowrap active:bg-neutral-300 @(IsDisabled ? "text-neutral-500 pointer-events-none" : "") @(CssClass)"
	role="menuitem"
	tabindex="0"
	@onclick="HandleClick"
	@oncontextmenu:preventDefault="true">
	@ChildContent
</div>

@code {
	[CascadingParameter] public required ContextMenu Menu { get; set; }
	
	[Parameter] public bool IsDisabled { get; set; }
	[Parameter] public string? CssClass { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	
	[Parameter] public EventCallback OnClick { get; set; }

	private void HandleClick()
	{
		if (IsDisabled) return;
		OnClick.InvokeAsync();
		Menu.Close();
	}
}