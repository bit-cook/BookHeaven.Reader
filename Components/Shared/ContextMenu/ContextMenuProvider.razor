@implements IDisposable
@if(_model is null) return;

<CascadingValue Value="_model">
    @_model.Content
</CascadingValue>
@code {
    [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
    [Inject] private IContextMenuService MenuService { get; set; } = null!;

    private ContextMenuModel? _model;

    protected override void OnInitialized()
    {
        MenuService.OnShow += Open;
        MenuService.OnClose += Close;
    }

    private async Task Open(ContextMenuModel model)
    {
        _model = model;
        await InvokeAsync(StateHasChanged);
    }
    
    private void Close()
    {
        _model = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MenuService.OnShow -= Open;
        MenuService.OnClose -= Close;
    }

}